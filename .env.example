# Single-user Telegram bot
BOT_TOKEN=
ADMIN_USER_ID=764315256
NOTIFIER_BACKEND=telegram        # telegram | stub

# Structured LLM evaluation and weekly catalog generation
LLM_BACKEND=ollama_mimo          # stub | ollama | mimo | ollama_mimo
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=glm-5:cloud
OLLAMA_API_KEY=ollama
MIMO_BASE_URL=https://api.xiaomimimo.com/anthropic
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=

# Speaking transcription and audio
STT_BACKEND=cloud                # cloud | stub
TTS_BACKEND=groq                 # groq | stub
GROQ_API_KEY=
OPENAI_API_KEY=
STT_MODEL=
STT_MAX_SECONDS=1800
TTS_MODEL=
TTS_VOICE=troy

# Calendar and weekly catalog maintenance
TZ=Europe/Moscow
PRACTICE_PUSH_CRON=0 8 * * *
CATALOG_REPLENISH_CRON=0 4 * * 0
CATALOG_BATCH_SIZE=3
CATALOG_SOURCE_URLS=https://science.nasa.gov/universe/,https://oceanservice.noaa.gov/facts/,https://www.si.edu/spotlight

# Durable local data
DB_PATH=data/tutor.db
DATA_DIR=data
